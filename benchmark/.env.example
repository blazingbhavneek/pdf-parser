# Paths are relative to this file. Environment variables override this file.
LLM_BASE_URL=http://82.79.85.125:42533/v1
LLM_MODEL=gemma-4-31B
LLM_API_KEY=
LLM_TIMEOUT=300
LLM_MAX_TOKENS=4096

# Optional: POST multipart form field "file", receive PDF bytes.
CONVERTER_URL=
CONVERTER_API_KEY=
CONVERTER_TIMEOUT=180
LIBREOFFICE_BIN=libreoffice

# Keep each tool's dependencies in its own environment.
MINERU_VENV=
DOCLING_VENV=
PADDLE_VENV=
DOTS_VENV=

# Optional command overrides. Tokens are split BEFORE placeholders are expanded;
# no shell is used. Available: {python}, {venv}, {input}, {output}, {attempt}.
# MinerU's default command is selected from the installed major version (2/3 or 4+).
MINERU_COMMAND=
DOCLING_COMMAND=
# Docling 2.138 with RapidOCR + onnxruntime and Japanese PP-OCRv6:
# DOCLING_COMMAND='docling convert {input} --to md --output {output} --ocr-engine rapidocr --ocr-lang iso:ja --table-mode accurate --image-export-mode referenced'
PADDLE_COMMAND=
# dots requires the command appropriate to your checkout/server. For example:
# DOTS_COMMAND='"{python}" -m dots_ocr.parser "{input}" --output "{output}"'
DOTS_COMMAND=
PIPELINE_TIMEOUT=1800
